.diy { display: block; }

/* 轮播 */
.diy-banner { width: 100%; height: 320rpx; }
.diy-banner-img { width: 100%; height: 320rpx; display: block; }

/* 金刚区 */
.diy-nav { display: flex; flex-wrap: wrap; background: #fff; padding: 24rpx 0; }
.diy-nav-item { display: flex; flex-direction: column; align-items: center; padding: 12rpx 0; }
.diy-nav-icon { width: 84rpx; height: 84rpx; border-radius: 50%; }
.diy-nav-text { font-size: 24rpx; color: #555; margin-top: 10rpx; }

/* 商品组 */
.diy-goods { background: #fff; margin: 16rpx; border-radius: 16rpx; padding: 16rpx; }
.diy-goods-title { font-size: 30rpx; font-weight: 600; padding: 16rpx 8rpx; }
.diy-goods-grid { display: flex; flex-wrap: wrap; }
.diy-goods-item { width: 50%; padding: 12rpx; }
.diy-goods-cover { width: 100%; height: 320rpx; border-radius: 12rpx; background: #f5f5f5; }
.diy-goods-name { font-size: 26rpx; color: #333; margin-top: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.diy-goods-price { font-size: 30rpx; margin-top: 6rpx; }

/* 商品分类入口 */
.diy-cat { background: #fff; margin: 16rpx; border-radius: 16rpx; padding: 16rpx; }
.diy-cat-title { font-size: 30rpx; font-weight: 600; padding: 16rpx 8rpx; }
.diy-cat-grid { display: flex; flex-wrap: wrap; }
.diy-cat-item { display: flex; flex-direction: column; align-items: center; padding: 12rpx 0; }
.diy-cat-icon { width: 88rpx; height: 88rpx; border-radius: 16rpx; background: #f5f5f5; }
.diy-cat-text { font-size: 24rpx; color: #555; margin-top: 10rpx; }
