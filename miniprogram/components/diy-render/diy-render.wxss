/* ===== Linear 风格设计令牌 ===== */
.diy {
  display: block;
  background: #f7f8fa;
  min-height: 100vh;
  padding-bottom: 24rpx;
}

/* 轮播 */
.diy-banner {
  width: calc(100% - 32rpx);
  height: 300rpx;
  margin: 16rpx;
  border-radius: 22rpx;
  overflow: hidden;
  background: #eceef1;
  box-shadow: 0 1rpx 3rpx rgba(17, 24, 39, 0.06), 0 8rpx 24rpx rgba(17, 24, 39, 0.05);
}
.diy-banner-img {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 22rpx;
}

/* 金刚区 / 魔方导航 */
.diy-nav {
  display: flex;
  flex-wrap: wrap;
  background: #fff;
  margin: 16rpx;
  padding: 28rpx 12rpx 20rpx;
  border-radius: 22rpx;
  box-shadow: 0 1rpx 2rpx rgba(17, 24, 39, 0.04), 0 6rpx 20rpx rgba(17, 24, 39, 0.04);
}
.diy-nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
}
.diy-nav-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: #f2f3f5;
  box-shadow: inset 0 0 0 1rpx rgba(17, 24, 39, 0.03);
}
.diy-nav-text {
  font-size: 23rpx;
  color: #4b5563;
  margin-top: 12rpx;
  font-weight: 500;
  letter-spacing: 0.2rpx;
}

/* 商品组 */
.diy-goods {
  background: #fff;
  margin: 16rpx;
  border-radius: 22rpx;
  padding: 20rpx;
  box-shadow: 0 1rpx 2rpx rgba(17, 24, 39, 0.04), 0 6rpx 20rpx rgba(17, 24, 39, 0.04);
}
.diy-goods-title {
  font-size: 31rpx;
  font-weight: 600;
  color: #111827;
  padding: 8rpx 6rpx 18rpx;
  letter-spacing: -0.4rpx;
}
.diy-mod {
  padding: 14rpx 0;
  border-top: 1rpx solid #f0f1f3;
}
.diy-mod:first-child {
  border-top: none;
  padding-top: 0;
}
.diy-mod-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #374151;
  padding: 4rpx 6rpx 12rpx;
  position: relative;
}
.diy-mod-title::before {
  content: '';
  display: inline-block;
  width: 6rpx;
  height: 24rpx;
  background: var(--primary);
  border-radius: 4rpx;
  margin-right: 12rpx;
  vertical-align: -4rpx;
}
.diy-goods-grid {
  display: flex;
  flex-wrap: wrap;
}
.diy-goods-item {
  padding: 10rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.diy-goods-card {
  display: flex;
  flex-direction: column;
  height: 100%;
}
.diy-goods-cover {
  width: 100%;
  height: 220rpx;
  border-radius: 16rpx;
  background: #f2f3f5;
  box-shadow: inset 0 0 0 1rpx rgba(17, 24, 39, 0.03);
}
.diy-goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}
.diy-goods-name {
  font-size: 25rpx;
  color: #374151;
  margin-top: 12rpx;
  line-height: 1.35;
  height: 70rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.diy-goods-sales {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 6rpx;
  min-height: 30rpx;
}
.diy-goods-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 8rpx;
}
.diy-goods-price {
  font-size: 31rpx;
  font-weight: 600;
  color: #FF4D4F;
  letter-spacing: -0.4rpx;
}
.diy-goods-cart {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(255, 77, 79, .1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.diy-goods-cart-ico { width: 28rpx; height: 28rpx; display: block; }

/* 商品分类入口 */
.diy-cat {
  background: #fff;
  margin: 16rpx;
  border-radius: 22rpx;
  padding: 20rpx;
  box-shadow: 0 1rpx 2rpx rgba(17, 24, 39, 0.04), 0 6rpx 20rpx rgba(17, 24, 39, 0.04);
}
.diy-cat-title {
  font-size: 31rpx;
  font-weight: 600;
  color: #111827;
  padding: 8rpx 6rpx 18rpx;
  letter-spacing: -0.4rpx;
}
.diy-cat-grid {
  display: flex;
  flex-wrap: wrap;
}
.diy-cat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
}
.diy-cat-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: #f2f3f5;
  box-shadow: inset 0 0 0 1rpx rgba(17, 24, 39, 0.03);
}
.diy-cat-text {
  font-size: 23rpx;
  color: #4b5563;
  margin-top: 12rpx;
  font-weight: 500;
  letter-spacing: 0.2rpx;
}

/* 通知公告 */
.diy-notice {
  display: flex;
  align-items: center;
  margin: 16rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  font-size: 25rpx;
  overflow: hidden;
  box-shadow: 0 1px 2px rgba(0,0,0,.04), 0 2px 8px rgba(94,106,210,.06);
}
.diy-notice-ico {
  font-size: 24rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
  background: rgba(94,106,210,.10);
  border-radius: 8rpx;
  padding: 6rpx 10rpx;
}
.diy-notice-ico-img {
  width: 28rpx;
  height: 28rpx;
  display: block;
}
/* 固定 */
.diy-notice-fixed { flex: 1; display: flex; flex-direction: column; }
.diy-notice-line { line-height: 1.6; padding: 4rpx 0; }
/* 从右往左划入（跑马灯） */
.diy-notice-marquee { flex: 1; overflow: hidden; white-space: nowrap; }
.diy-notice-marquee-track {
  display: inline-block;
  white-space: nowrap;
  padding-left: 100%;
  animation: noticeLeft 14s linear infinite;
}
@keyframes noticeLeft {
  0% { transform: translateX(0); }
  100% { transform: translateX(-100%); }
}
/* 自上而下滚动 */
.diy-notice-vertical { flex: 1; height: 40rpx; overflow: hidden; }
.diy-notice-vertical-track { animation: noticeUp 8s linear infinite; }
.diy-notice-vline { height: 40rpx; line-height: 40rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
@keyframes noticeUp {
  0% { transform: translateY(0); }
  100% { transform: translateY(-50%); }
}

/* 广告位（我方广告位） */
.diy-bannerad{margin:16rpx;}
.diy-bannerad-title{font-size:31rpx;font-weight:600;color:#111827;padding:8rpx 6rpx 12rpx;letter-spacing:-0.4rpx;}
.diy-bannerad-grid{display:flex;flex-wrap:wrap;}
.diy-bannerad-item{box-sizing:border-box;padding:4rpx;}
.diy-bannerad-img{width:100%;display:block;border-radius:14rpx;background:#f2f3f5;}
