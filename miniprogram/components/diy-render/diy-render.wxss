/* ===== Linear 风格设计令牌 ===== */
.diy {
  display: block;
  background: #f7f8fa;
  min-height: 100vh;
  padding-bottom: 24rpx;
}

/* 轮播 */
.diy-banner {
  width: calc(100% - 32rpx);
  height: 300rpx;
  margin: 16rpx;
  border-radius: 22rpx;
  overflow: hidden;
  background: #eceef1;
  box-shadow: 0 1rpx 3rpx rgba(17, 24, 39, 0.06), 0 8rpx 24rpx rgba(17, 24, 39, 0.05);
}
.diy-banner-img {
  width: 100%;
  height: 300rpx;
  display: block;
  border-radius: 22rpx;
}

/* 金刚区 / 魔方导航 */
.diy-nav {
  display: flex;
  flex-wrap: wrap;
  background: #fff;
  margin: 16rpx;
  padding: 28rpx 12rpx 20rpx;
  border-radius: 22rpx;
  box-shadow: 0 1rpx 2rpx rgba(17, 24, 39, 0.04), 0 6rpx 20rpx rgba(17, 24, 39, 0.04);
}
.diy-nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
}
.diy-nav-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: #f2f3f5;
  box-shadow: inset 0 0 0 1rpx rgba(17, 24, 39, 0.03);
}
.diy-nav-text {
  font-size: 23rpx;
  color: #4b5563;
  margin-top: 12rpx;
  font-weight: 500;
  letter-spacing: 0.2rpx;
}

/* 商品组 */
.diy-goods {
  background: #fff;
  margin: 16rpx;
  border-radius: 22rpx;
  padding: 20rpx;
  box-shadow: 0 1rpx 2rpx rgba(17, 24, 39, 0.04), 0 6rpx 20rpx rgba(17, 24, 39, 0.04);
}
.diy-goods-title {
  font-size: 31rpx;
  font-weight: 600;
  color: #111827;
  padding: 8rpx 6rpx 18rpx;
  letter-spacing: -0.4rpx;
}
.diy-mod {
  padding: 14rpx 0;
  border-top: 1rpx solid #f0f1f3;
}
.diy-mod:first-child {
  border-top: none;
  padding-top: 0;
}
.diy-mod-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #374151;
  padding: 4rpx 6rpx 12rpx;
  position: relative;
}
.diy-mod-title::before {
  content: '';
  display: inline-block;
  width: 6rpx;
  height: 24rpx;
  background: #5e6ad2;
  border-radius: 4rpx;
  margin-right: 12rpx;
  vertical-align: -4rpx;
}
.diy-goods-grid {
  display: flex;
  flex-wrap: wrap;
}
.diy-goods-item {
  padding: 10rpx;
  box-sizing: border-box;
}
.diy-goods-cover {
  width: 100%;
  height: 220rpx;
  border-radius: 16rpx;
  background: #f2f3f5;
  box-shadow: inset 0 0 0 1rpx rgba(17, 24, 39, 0.03);
}
.diy-goods-name {
  font-size: 25rpx;
  color: #374151;
  margin-top: 12rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.diy-goods-price {
  font-size: 31rpx;
  font-weight: 600;
  color: #5e6ad2;
  margin-top: 8rpx;
  letter-spacing: -0.4rpx;
}

/* 商品分类入口 */
.diy-cat {
  background: #fff;
  margin: 16rpx;
  border-radius: 22rpx;
  padding: 20rpx;
  box-shadow: 0 1rpx 2rpx rgba(17, 24, 39, 0.04), 0 6rpx 20rpx rgba(17, 24, 39, 0.04);
}
.diy-cat-title {
  font-size: 31rpx;
  font-weight: 600;
  color: #111827;
  padding: 8rpx 6rpx 18rpx;
  letter-spacing: -0.4rpx;
}
.diy-cat-grid {
  display: flex;
  flex-wrap: wrap;
}
.diy-cat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
}
.diy-cat-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: #f2f3f5;
  box-shadow: inset 0 0 0 1rpx rgba(17, 24, 39, 0.03);
}
.diy-cat-text {
  font-size: 23rpx;
  color: #4b5563;
  margin-top: 12rpx;
  font-weight: 500;
  letter-spacing: 0.2rpx;
}
