<view class="diy">
  <block wx:for="{{viewList}}" wx:key="sort" wx:for-item="c">

    <!-- 轮播图 -->
    <swiper wx:if="{{c.type === 'banner'}}" class="diy-banner" indicator-dots autoplay circular
      style="height:{{c.props.height || 300}}rpx"
      interval="{{c.props.interval * 1000}}" duration="400" indicator-active-color="var(--primary)" indicator-color="rgba(17,24,39,0.15)">
      <swiper-item wx:for="{{c.props.items}}" wx:for-item="b" wx:for-index="bi" wx:key="bi">
        <image wx:if="{{b.type !== 'video'}}" class="diy-banner-img" src="{{b.image}}" mode="aspectFill" data-link="{{b.link}}" bindtap="onTapLink" />
        <video wx:else class="diy-banner-img" src="{{b.video}}" mode="aspectFill" autoplay loop muted show-center-play-btn="{{false}}" data-link="{{b.link}}" bindtap="onTapLink" />
      </swiper-item>
    </swiper>

    <!-- 金刚区 / 图标导航 -->
    <view wx:if="{{c.type === 'nav_grid'}}" class="diy-nav">
      <view class="diy-nav-item" wx:for="{{c.props.items}}" wx:for-item="n" wx:key="text"
        style="width:{{c.colWidth}}" data-link="{{n.link}}" bindtap="onTapLink">
        <image class="diy-nav-icon" src="{{n.icon}}" mode="aspectFill" />
        <text class="diy-nav-text">{{n.text}}</text>
      </view>
    </view>

    <!-- 精选推荐 / 推荐模块 -->
    <view wx:if="{{c.type === 'goods_group'}}" class="diy-goods">
      <view class="diy-goods-title" wx:if="{{c.props.title}}">{{c.props.title}}</view>
      <view class="diy-mod" wx:for="{{c.modules}}" wx:for-item="m" wx:key="id">
        <view class="diy-mod-title" wx:if="{{m.title}}">{{m.title}}</view>
        <view class="diy-goods-grid">
          <view class="diy-goods-item" wx:for="{{m.goods}}" wx:for-item="g" wx:key="id" style="width:{{c.colWidth}}">
            <view class="diy-goods-card" data-id="{{g.id}}" bindtap="onTapGoods">
              <image class="diy-goods-cover" src="{{g.cover}}" mode="aspectFill" />
              <view class="diy-goods-info">
                <view class="diy-goods-name">{{g.title}}</view>
                <view class="diy-goods-sales">销量：{{g.sales || 0}}</view>
                <view class="diy-goods-row">
                  <view class="diy-goods-price">¥{{g.price}}</view>
                  <view wx:if="{{cartIcon}}" class="diy-goods-cart" style="background: {{cartIconBg}};" catchtap="onTapCart" data-id="{{g.id}}">
                    <image class="diy-goods-cart-ico" src="{{cartIcon}}" mode="aspectFit" />
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 商品分类入口 -->
    <view wx:if="{{c.type === 'category_nav'}}" class="diy-cat">
      <view class="diy-cat-title" wx:if="{{c.props.title}}">{{c.props.title}}</view>
      <view class="diy-cat-grid">
        <view class="diy-cat-item" wx:for="{{c.catList}}" wx:for-item="cat" wx:key="id"
          style="width:{{c.colWidth}}" data-id="{{cat.id}}" bindtap="onTapCategory">
          <image class="diy-cat-icon" src="{{cat.icon}}" mode="aspectFill" />
          <text class="diy-cat-text">{{cat.name}}</text>
        </view>
      </view>
    </view>

    <!-- 通知公告 -->
    <view wx:if="{{c.type === 'notice'}}" class="diy-notice" style="background:{{c.bg}};color:{{c.color}}">
      <view class="diy-notice-ico">
        <image wx:if="{{c.iconIsImg}}" class="diy-notice-ico-img" src="{{c.icon}}" mode="aspectFit"></image>
        <text wx:else>{{c.icon || '📢'}}</text>
      </view>
      <!-- 固定 -->
      <view wx:if="{{c.noticeStyle === 'fixed'}}" class="diy-notice-fixed">
        <view wx:for="{{c.items}}" wx:for-item="nt" wx:for-index="ni" wx:key="ni" class="diy-notice-line" data-link="{{nt.link}}" bindtap="onTapLink">{{nt.text}}</view>
      </view>
      <!-- 从右往左划入（跑马灯） -->
      <view wx:elif="{{c.noticeStyle === 'marquee'}}" class="diy-notice-marquee" data-link="{{c.items[0].link}}" bindtap="onTapLink">
        <view class="diy-notice-marquee-track">{{c.marqueeText}}</view>
      </view>
      <!-- 自上而下滚动 -->
      <view wx:else class="diy-notice-vertical" data-link="{{c.items[0].link}}" bindtap="onTapLink">
        <view class="diy-notice-vertical-track">
          <view wx:for="{{c.vItems}}" wx:for-item="nt" wx:for-index="ni" wx:key="ni" class="diy-notice-vline">{{nt.text}}</view>
        </view>
      </view>
    </view>

    <!-- 广告位（我方广告位） -->
    <view wx:if="{{c.type === 'banner_ad'}}" class="diy-bannerad">
      <view class="diy-bannerad-title" wx:if="{{c.props.title}}">{{c.props.title}}</view>
      <view class="diy-bannerad-grid">
        <view class="diy-bannerad-item" wx:for="{{c.props.banners}}" wx:for-item="ad" wx:for-index="adi" wx:key="adi"
          style="width:{{100 / (c.props.columns || 1)}}%"
          data-link="{{ad.link}}" bindtap="onTapLink">
          <image class="diy-bannerad-img" src="{{ad.image}}" mode="widthFix" />
        </view>
      </view>
    </view>

    <!-- 文章列表模块 -->
    <view wx:if="{{c.type === 'article_list'}}" class="diy-articles">
      <view wx:if="{{!c.articleModule.hide_title}}" class="diy-articles-head">
        <view class="diy-articles-title">{{c.articleModule.title}}</view>
        <view class="diy-articles-more" data-link="{{c.articleModule.more_link}}" bindtap="onTapLink">更多 ></view>
      </view>

      <!-- 单图+文字布局 -->
      <view wx:if="{{c.articleModule.layout === 'single'}}" class="diy-articles-single">
        <view wx:if="{{c.articles.length === 0}}" class="diy-articles-empty">暂无文章</view>
        <view wx:for="{{c.articles}}" wx:key="id" wx:for-item="a"
          class="diy-art-row" data-id="{{a.id}}" bindtap="onTapArticle">
          <view class="diy-art-row-info">
            <view class="diy-art-title">{{a.title}}</view>
            <view wx:if="{{c.articleModule.show_intro && a.intro}}" class="diy-art-intro">{{a.intro}}</view>
            <view class="diy-art-meta">
              <text wx:if="{{c.articleModule.show_date && a.publish_time_text}}" class="diy-art-date">{{a.publish_time_text}}</text>
              <text wx:if="{{c.articleModule.show_views}}" class="diy-art-views">{{a.views}} 浏览</text>
            </view>
          </view>
          <image wx:if="{{a.cover_image}}" class="diy-art-cover" src="{{a.cover_image}}" mode="aspectFill" />
        </view>
      </view>

      <!-- 双图横排布局 -->
      <view wx:elif="{{c.articleModule.layout === 'multi'}}" class="diy-articles-multi">
        <view wx:if="{{c.articles.length === 0}}" class="diy-articles-empty">暂无文章</view>
        <view class="diy-articles-grid">
          <view wx:for="{{c.articles}}" wx:key="id" wx:for-item="a"
            class="diy-art-cell" data-id="{{a.id}}" bindtap="onTapArticle">
            <image wx:if="{{a.cover_image}}" class="diy-art-cell-cover" src="{{a.cover_image}}" mode="aspectFill" />
            <view wx:else class="diy-art-cell-cover diy-art-cell-cover--empty"></view>
            <view class="diy-art-cell-info">
              <view class="diy-art-title diy-art-title--cell">{{a.title}}</view>
              <view wx:if="{{c.articleModule.show_intro && a.intro}}" class="diy-art-intro diy-art-intro--cell">{{a.intro}}</view>
              <view class="diy-art-meta">
                <text wx:if="{{c.articleModule.show_date && a.publish_time_text}}" class="diy-art-date">{{a.publish_time_text}}</text>
                <text wx:if="{{c.articleModule.show_views}}" class="diy-art-views">{{a.views}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

  </block>
</view>
