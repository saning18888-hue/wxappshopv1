.cate { display: flex; height: 100vh; background: #fff; }
.cate-left { width: 200rpx; background: #f5f5f5; }
.cate-left-item {
  padding: 36rpx 16rpx;
  text-align: center;
  font-size: 28rpx;
  color: #555;
  border-left: 6rpx solid transparent;
}
.cate-left-item.active {
  background: #fff;
  color: #FF6B35;
  font-weight: 600;
  border-left-color: #FF6B35;
}
.cate-right { flex: 1; padding: 24rpx; }
.cate-right-title { font-size: 28rpx; color: #999; margin-bottom: 16rpx; }
.cate-right-grid { display: flex; flex-wrap: wrap; }
.cate-right-item {
  width: 50%;
  padding: 20rpx 12rpx;
  text-align: center;
}
.cate-right-name {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #333;
}
