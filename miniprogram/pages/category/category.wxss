.page { display: flex; flex-direction: column; height: 100vh; }
.search-bar { flex-shrink: 0; padding: 16rpx 24rpx; background: #fff; }
.search-input-wrap {
  display: flex;
  align-items: center;
  height: 64rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
  padding: 0 20rpx;
}
.search-icon { width: 32rpx; height: 32rpx; margin-right: 12rpx; }
.search-input { flex: 1; font-size: 28rpx; color: #333; }
.search-clear { width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center; font-size: 32rpx; color: #999; }

.cate { display: flex; flex: 1; min-height: 0; }
.cate-left {
  width: 180rpx;
  background: #f5f5f5;
  height: 100%;
  overflow-y: auto;
}
.cate-left-item {
  padding: 28rpx 20rpx;
  font-size: 26rpx;
  color: #333;
  text-align: center;
  border-left: 4rpx solid transparent;
}
.cate-left-item.active {
  background: #fff;
  color: var(--primary);
  font-weight: 600;
  border-left-color: var(--primary);
}
.cate-right { flex: 1; height: 100%; padding: 12rpx; background: #fff; }
.empty { text-align: center; color: #999; font-size: 28rpx; padding: 60rpx 0; }

.goods-grid { display: flex; flex-wrap: wrap; }
.goods-cell {
  width: 50%;
  padding: 12rpx;
}
.goods-cell > view, .goods-cell > image { width: 100%; }
.goods-cover {
  height: 220rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
}
.goods-name {
  font-size: 26rpx;
  color: #333;
  margin-top: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.goods-sub { font-size: 22rpx; color: #999; margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.goods-price { font-size: 30rpx; color: var(--primary); margin-top: 8rpx; }
.goods-market { font-size: 22rpx; color: #999; text-decoration: line-through; margin-left: 10rpx; }
.goods-sales { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.goods-bottom { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 8rpx; }
.goods-cart {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #FF3B30;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(255,59,48,0.25);
}
.goods-cart-plus { font-size: 32rpx; line-height: 1; font-weight: bold; }
