/* ========== 通用 ========== */
.page { display: flex; flex-direction: column; height: 100vh; }
.empty { text-align: center; color: #999; font-size: 28rpx; padding: 60rpx 0; }

/* ========== 竖版（vertical）========== */
.page-vertical .search-bar { flex-shrink: 0; padding: 16rpx 24rpx; background: #fff; }
.page-vertical .search-input-wrap {
  display: flex; align-items: center;
  height: 64rpx; background: #f5f5f5;
  border-radius: 32rpx; padding: 0 20rpx;
}
.page-vertical .search-icon { width: 32rpx; height: 32rpx; margin-right: 12rpx; }
.page-vertical .search-input { flex: 1; font-size: 28rpx; color: #333; }
.page-vertical .search-clear { width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center; font-size: 32rpx; color: #999; }

.page-vertical .cate { display: flex; flex: 1; min-height: 0; }
.page-vertical .cate-left {
  width: 180rpx; background: #f5f5f5;
  height: 100%; overflow-y: auto;
}
.page-vertical .cate-left-item {
  padding: 28rpx 20rpx; font-size: 26rpx; color: #333;
  text-align: center; border-left: 4rpx solid transparent;
}
.page-vertical .cate-left-item.active {
  background: #fff; color: var(--primary);
  font-weight: 600; border-left-color: var(--primary);
}
.page-vertical .cate-right { flex: 1; height: 100%; padding: 12rpx; background: #fff; }

.page-vertical .goods-grid { display: flex; flex-wrap: wrap; }
.page-vertical .goods-cell { width: 50%; padding: 12rpx; }
.page-vertical .goods-cell > view, .page-vertical .goods-cell > image { width: 100%; }
.page-vertical .goods-cover {
  height: 220rpx; border-radius: 12rpx; background: #f5f5f5;
}
.page-vertical .goods-name {
  font-size: 26rpx; color: #333; margin-top: 10rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.page-vertical .goods-price { font-size: 30rpx; color: var(--primary); margin-top: 8rpx; }
.page-vertical .goods-market { font-size: 22rpx; color: #999; text-decoration: line-through; margin-left: 10rpx; }
.page-vertical .goods-sales { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.page-vertical .goods-bottom { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 8rpx; }
.page-vertical .goods-cart {
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: #FF3B30; color: #fff;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(255,59,48,0.25);
}
.page-vertical .goods-cart-plus { font-size: 32rpx; line-height: 1; font-weight: bold; }

/* ========== 横版（horizontal）========== */


/* 横滑分类 chip */
.page-horizontal .h-chips {
  flex-shrink: 0;
  white-space: nowrap;
  background: #fff;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.page-horizontal .h-chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #555;
  background: #f5f5f5;
  border-radius: 32rpx;
  transition: all .15s;
}
.page-horizontal .h-chip:last-child { margin-right: 20rpx; }
.page-horizontal .h-chip.active {
  color: var(--primary);
  background: rgba(255, 107, 53, 0.12);  /* 主题色 12% 透明 */
  font-weight: 600;
}

/* 商品横卡片列表 */
.page-horizontal .h-list {
  flex: 1; min-height: 0;
  background: #f7f7f7;
  padding: 16rpx 20rpx;
}
.page-horizontal .h-card {
  display: flex; align-items: stretch;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  position: relative;
}
.page-horizontal .h-card-cover {
  width: 200rpx; height: 200rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}
.page-horizontal .h-card-info {
  flex: 1; min-width: 0;
  margin-left: 24rpx;
  display: flex; flex-direction: column;
  justify-content: space-between;
}
.page-horizontal .h-card-title {
  font-size: 28rpx; color: #333;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.page-horizontal .h-card-sales {
  font-size: 22rpx; color: #999;
  margin-top: 8rpx;
}
.page-horizontal .h-card-bottom {
  display: flex; align-items: flex-end; justify-content: space-between;
  margin-top: 8rpx;
}
.page-horizontal .h-card-price {
  font-size: 32rpx; color: var(--primary); font-weight: 600;
}
.page-horizontal .h-card-market {
  font-size: 22rpx; color: #999; text-decoration: line-through; margin-left: 12rpx; font-weight: normal;
}
.page-horizontal .h-card-cart {
  position: absolute; right: 20rpx; bottom: 20rpx;
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  font-size: 36rpx; line-height: 56rpx;
  text-align: center;
  box-shadow: 0 6rpx 16rpx rgba(255,107,53,0.35);
}

/* 商品卡片促销语（红标风格，受后台 show_promo 开关控制） */
.page-vertical .goods-promo {
  font-size: 20rpx; color: #FF3B30;
  background: rgba(255, 59, 48, 0.08);
  border-radius: 6rpx; padding: 4rpx 10rpx;
  margin-top: 6rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.page-horizontal .h-card-promo {
  font-size: 20rpx; color: #FF3B30;
  background: rgba(255, 59, 48, 0.08);
  border-radius: 6rpx; padding: 4rpx 10rpx;
  margin-top: 8rpx; align-self: flex-start; max-width: 100%;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}