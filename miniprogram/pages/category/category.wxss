.cate { display: flex; height: 100vh; }
.cate-left {
  width: 180rpx;
  background: #f5f5f5;
  height: 100vh;
  overflow-y: auto;
}
.cate-left-item {
  padding: 28rpx 20rpx;
  font-size: 26rpx;
  color: #333;
  text-align: center;
  border-left: 4rpx solid transparent;
}
.cate-left-item.active {
  background: #fff;
  color: var(--primary);
  font-weight: 600;
  border-left-color: var(--primary);
}
.cate-right { flex: 1; padding: 24rpx; }
.cate-right-title { font-size: 28rpx; color: #999; margin-bottom: 16rpx; }
.cate-right-grid { display: flex; flex-wrap: wrap; }
.cate-right-item {
  width: 50%;
  padding: 20rpx 12rpx;
  text-align: center;
}
.cate-right-name {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #333;
}
