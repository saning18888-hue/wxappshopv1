.cate { display: flex; height: calc(100vh - 140rpx); }
.cate-left {
  width: 180rpx;
  background: #f5f5f5;
  height: calc(100vh - 140rpx);
  overflow-y: auto;
}
.cate-left-item {
  padding: 28rpx 20rpx;
  font-size: 26rpx;
  color: #333;
  text-align: center;
  border-left: 4rpx solid transparent;
}
.cate-left-item.active {
  background: #fff;
  color: var(--primary);
  font-weight: 600;
  border-left-color: var(--primary);
}
.cate-right { flex: 1; height: calc(100vh - 140rpx); padding: 12rpx; background: #fff; }
.empty { text-align: center; color: #999; font-size: 28rpx; padding: 60rpx 0; }

.goods-grid { display: flex; flex-wrap: wrap; }
.goods-cell {
  width: 50%;
  padding: 12rpx;
}
.goods-cell > view, .goods-cell > image { width: 100%; }
.goods-cover {
  height: 220rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
}
.goods-name {
  font-size: 26rpx;
  color: #333;
  margin-top: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.goods-sub { font-size: 22rpx; color: #999; margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.goods-price { font-size: 30rpx; color: var(--primary); margin-top: 8rpx; }
.goods-market { font-size: 22rpx; color: #999; text-decoration: line-through; margin-left: 10rpx; }
.goods-sales { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.goods-bottom { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 8rpx; }
.goods-cart {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.12);
}
.goods-cart-icon { width: 28rpx; height: 28rpx; }
