<view class="page" style="--primary:{{themeColor}}">
  <view class="tabs">
    <view wx:for="{{tabs}}" wx:key="key" class="tab {{tabIndex===index?'on':''}}" data-i="{{index}}" bindtap="switchTab">{{item.label}}</view>
  </view>

  <view wx:if="{{list.length===0 && !loading}}" class="empty">暂无相关订单</view>

  <view class="list">
    <view wx:for="{{list}}" wx:key="id" class="order" bindtap="goDetail" data-id="{{item.id}}">
      <view class="o-head">
        <text class="o-no" bindtap="goDetail" data-id="{{item.id}}">订单号 {{item.order_no}}</text>
        <text class="o-status">{{item.refund_status ? item.refund_status_text : item.status_text}}</text>
      </view>
      <view wx:for="{{item.items}}" wx:for-item="it" wx:key="sku_id" class="g-row">
        <image class="g-img" src="{{it.image}}" mode="aspectFill" />
        <view class="g-info">
          <view class="g-title">{{it.title}}</view>
          <text class="g-spec" wx:if="{{it.spec_desc}}">{{it.spec_desc}}</text>
          <view class="g-bottom">
            <text class="g-price">¥{{it.price_yuan}}</text>
            <text class="g-qty">x{{it.quantity}}</text>
          </view>
        </view>
      </view>
      <view class="o-foot">
        <text class="o-amt">合计 ¥{{item.price_yuan}}</text>
        <view class="o-acts">
          <text wx:if="{{item.refund_status==='pending' || item.refund_status==='approved'}}" class="btn ghost" catchtap="goDetail" data-id="{{item.id}}">查看售后</text>
          <text wx:elif="{{item.status===1 || item.status===2 || item.status===3 || item.status===5}}" class="btn primary" catchtap="goAftersale" data-id="{{item.id}}">申请售后</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>
  <view wx:if="{{finished && list.length}}" class="loading">没有更多了</view>
</view>
