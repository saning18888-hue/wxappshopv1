.page { min-height: 100vh; background: #f5f5f5; padding-bottom: 24rpx; }
.tabs {
  display: flex; position: sticky; top: 0; z-index: 10;
  background: #fff; border-bottom: 1rpx solid #eee;
}
.tab {
  flex: 1; text-align: center; font-size: 26rpx; color: #666;
  padding: 22rpx 0; position: relative;
}
.tab.on { color: var(--primary); font-weight: 600; }
.tab.on::after {
  content: ''; position: absolute; left: 50%; bottom: 6rpx; transform: translateX(-50%);
  width: 40rpx; height: 6rpx; border-radius: 3rpx; background: var(--primary);
}
.empty { text-align: center; color: #999; font-size: 28rpx; padding: 120rpx 0; }
.list { padding: 20rpx; }
.order {
  background: #fff; border-radius: 16rpx; margin-bottom: 20rpx;
  padding: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.o-head { display: flex; justify-content: space-between; align-items: center; font-size: 24rpx; color: #999; margin-bottom: 12rpx; }
.o-status { color: var(--primary); font-weight: 600; }
.g-row { display: flex; padding: 12rpx 0; border-top: 1rpx solid #f3f3f3; }
.g-img { width: 120rpx; height: 120rpx; border-radius: 12rpx; background: #f3f3f3; flex-shrink: 0; }
.g-info { flex: 1; margin-left: 16rpx; }
.g-title { font-size: 28rpx; color: #333; }
.g-spec { font-size: 22rpx; color: #999; }
.g-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 10rpx; }
.g-price { color: #E54D42; font-size: 28rpx; }
.g-qty { color: #999; font-size: 24rpx; }
.o-foot { display: flex; justify-content: space-between; align-items: center; margin-top: 12rpx; padding-top: 12rpx; border-top: 1rpx solid #f3f3f3; }
.o-amt { font-size: 26rpx; color: #333; }
.o-acts { display: flex; }
.btn { font-size: 24rpx; padding: 10rpx 22rpx; border-radius: 30rpx; margin-left: 16rpx; }
.btn.primary { background: var(--primary); color: #fff; }
.btn.ghost { border: 1rpx solid var(--primary); color: var(--primary); }
.loading { text-align: center; color: #999; font-size: 24rpx; padding: 20rpx; }
