.page {
  display: block;
  min-height: 100vh;
  background: #f7f8fa;
  padding: 16rpx 0 48rpx;
}
.state {
  padding: 120rpx 0;
  text-align: center;
  color: #6b7280;
  font-size: 28rpx;
}
.state.error {
  color: #ef4444;
}
.list {
  padding: 0 24rpx;
}
.item {
  display: flex;
  gap: 24rpx;
  background: #fff;
  padding: 24rpx;
  border-radius: 18rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 1rpx 2rpx rgba(17, 24, 39, 0.04), 0 6rpx 20rpx rgba(17, 24, 39, 0.04);
}
.item:active {
  background: #f5f6f8;
}
.item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.item-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.item-intro {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 10rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.item-meta {
  display: flex;
  gap: 14rpx;
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 14rpx;
  flex-wrap: wrap;
}
.item-cat {
  background: rgba(94, 106, 210, 0.1);
  color: #5e6ad2;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
}
.item-cover {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: #f0f1f3;
  flex-shrink: 0;
}
.footer {
  padding: 24rpx 0;
  text-align: center;
  color: #9ca3af;
  font-size: 24rpx;
}