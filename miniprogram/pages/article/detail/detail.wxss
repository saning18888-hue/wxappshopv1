.page {
  display: block;
  min-height: 100vh;
  background: #f7f8fa;
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}
.state {
  padding: 120rpx 0;
  text-align: center;
  color: #6b7280;
  font-size: 28rpx;
}
.state.error {
  color: #ef4444;
}
.cover {
  width: 100%;
  height: 380rpx;
  border-radius: 22rpx;
  overflow: hidden;
  background: #eceef1;
  box-shadow: 0 2rpx 8rpx rgba(17, 24, 39, 0.05);
}
.cover image {
  width: 100%;
  height: 100%;
  display: block;
}
.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #111827;
  margin: 32rpx 0 16rpx;
  line-height: 1.4;
  letter-spacing: -0.5rpx;
}
.meta {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  font-size: 23rpx;
  color: #9ca3af;
  margin-bottom: 24rpx;
}
.meta-cat {
  background: rgba(94, 106, 210, 0.1);
  color: #5e6ad2;
  padding: 4rpx 14rpx;
  border-radius: 14rpx;
  font-weight: 500;
}
.meta-date,
.meta-views {
  line-height: 32rpx;
}
.intro {
  font-size: 28rpx;
  color: #4b5563;
  background: #f0f1f3;
  border-left: 6rpx solid var(--primary, #5e6ad2);
  padding: 20rpx 24rpx;
  border-radius: 0 12rpx 12rpx 0;
  margin-bottom: 28rpx;
  line-height: 1.6;
}
.content {
  background: #fff;
  padding: 28rpx 32rpx;
  border-radius: 18rpx;
  font-size: 30rpx;
  color: #1f2937;
  line-height: 1.85;
  white-space: pre-wrap;
  word-break: break-word;
  box-shadow: 0 1rpx 2rpx rgba(17, 24, 39, 0.04), 0 6rpx 20rpx rgba(17, 24, 39, 0.04);
}
.recommend-tag {
  display: inline-block;
  margin-top: 24rpx;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  color: #fff;
  background: linear-gradient(135deg, #f59e0b 0%, #ef4444 100%);
  border-radius: 8rpx;
  font-weight: 500;
}