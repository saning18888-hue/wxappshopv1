.home { min-height: 100vh; padding-bottom: 140rpx; box-sizing: border-box; }

/* 小程序名称 / 页面标题 */
.app-header { padding: 20rpx 30rpx 10rpx; }
.app-title { color: #fff; font-size: 38rpx; font-weight: 700; line-height: 1.4; }
.app-subtitle { margin-top: 8rpx; font-size: 26rpx; line-height: 1.4; opacity: .9; }

/* 滚动订单提示 */
.scroll-order {
  position: fixed; left: 20rpx; top: 240rpx; z-index: 50;
  display: flex; align-items: center; gap: 12rpx;
  height: 64rpx; padding: 0 22rpx 0 14rpx;
  border-radius: 999rpx;
  background: rgba(0,0,0,.72);
  backdrop-filter: blur(4rpx);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,.18);
  animation: scrollOrderIn .5s ease forwards;
}
.scroll-order-avatar {
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: linear-gradient(135deg, #5B8FF9, #5AD8A6);
  flex-shrink: 0;
}
.scroll-order-text { color: #fff; font-size: 24rpx; white-space: nowrap; }
.scroll-order-name { font-weight: 600; }
@keyframes scrollOrderIn {
  from { opacity: 0; transform: translateX(-20rpx); }
  to { opacity: 1; transform: translateX(0); }
}

/* 搜索栏 */
.search-bar {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--primary);
  padding: 16rpx 24rpx;
}
.search-box {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 999rpx;
  padding: 0 24rpx;
  height: 72rpx;
}
.search-ico-img { width: 32rpx; height: 32rpx; margin-right: 12rpx; flex-shrink: 0; }
.search-input { flex: 1; font-size: 28rpx; }

/* 站点打烊全页拦截 */
.site-closed {
  position: fixed; inset: 0; z-index: 999;
  background: rgba(0,0,0,.55);
  display: flex; align-items: center; justify-content: center;
}
.site-closed-box {
  width: 560rpx; background: #fff; border-radius: 20rpx;
  padding: 56rpx 40rpx; text-align: center;
}
.site-closed-ico { font-size: 72rpx; }
.site-closed-title { font-size: 36rpx; font-weight: 700; margin: 20rpx 0 12rpx; }
.site-closed-reason { font-size: 26rpx; color: #888; line-height: 1.6; }

/* 加载中 */
.empty { text-align: center; color: #999; font-size: 26rpx; padding: 120rpx 0; }

/* 小程序版权（后台平台权限配置） */
.copyright-box {
  padding: 40rpx 32rpx 60rpx;
  text-align: center;
  box-sizing: border-box;
}
.copyright-img { width: 360rpx; height: auto; }
.copyright-text { font-size: 22rpx; color: #999; line-height: 1.6; word-break: break-all; }
