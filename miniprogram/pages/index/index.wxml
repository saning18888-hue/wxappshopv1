<view class="home" style="--primary:{{themeColor}}">

  <!-- 小程序名称 / 页面标题（基础设置 → 页面标题对齐：靠左 / 居中） -->
  <view class="app-header" style="background:{{themeColor}}">
    <view class="app-title" style="text-align:{{pageTitleAlign}};color:{{miniProgramNameColor}}">{{miniProgramName}}</view>
    <view wx:if="{{homeSubtitle}}" class="app-subtitle" style="color:{{miniProgramNameColor}}">{{homeSubtitle}}</view>
  </view>

  <!-- 滚动订单提示（左上角） -->
  <view wx:if="{{scrollOrder === 'open' && scrollOrderVisible && scrollOrderList.length}}" class="scroll-order">
    <view class="scroll-order-avatar"></view>
    <view class="scroll-order-text">
      <text class="scroll-order-name">{{scrollOrderList[currentScrollOrder].name}}</text>
      <text> {{scrollOrderList[currentScrollOrder].text}}</text>
    </view>
  </view>

  <!-- 搜索栏（背景为小程序主题色；搜索框颜色/图标可配置） -->
  <view class="search-bar" style="background:{{themeColor}}">
    <view class="search-box" style="background:{{searchBoxColor}}">
      <image class="search-ico-img" src="{{searchBoxIcon}}" mode="aspectFit"></image>
      <input class="search-input" placeholder="{{searchPlaceholder}}" confirm-type="search" bindconfirm="onSearch" />
    </view>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中...</view>
  <diy-render wx:else components="{{components}}" goodsList="{{goodsList}}" cats="{{cats}}" />

  <!-- 全局悬浮按钮（购物车 / 返回首页 / 客服），所有页面统一 -->
  <float-buttons />

  <!-- 站点状态：打烊时全页拦截 -->
  <view wx:if="{{siteClosed}}" class="site-closed">
    <view class="site-closed-box">
      <view class="site-closed-ico">🚫</view>
      <view class="site-closed-title">商城已打烊</view>
      <view class="site-closed-reason">{{closeReason}}</view>
    </view>
  </view>

  <!-- 小程序版权 -->
  <view class="copyright-box" wx:if="{{copyright.type === 'image' || copyright.type === 'text'}}">
    <image wx:if="{{copyright.type === 'image' && copyright.image}}" class="copyright-img" src="{{copyright.image}}" mode="widthFix" />
    <text wx:if="{{copyright.type === 'text' && copyright.text}}" class="copyright-text">{{copyright.text}}</text>
  </view>
</view>
