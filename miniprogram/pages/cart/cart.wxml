<view class="cart" style="--primary:{{themeColor}}; --status-bar:{{statusBarHeight}}px; --nav-height:{{navHeight}}px;">
  <!-- 标题栏 -->
  <view class="cart-header" style="padding-top:{{statusBarHeight}}px;height:{{navHeight}}px;">
    <view class="cart-title">购物车</view>
    <view wx:if="{{list.length > 0}}" class="cart-manage" bindtap="toggleEdit">{{isEdit ? '完成' : '管理'}}</view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{list.length === 0}}" class="empty-state">
    <image class="empty-img" src="/images/empty-cart.svg" mode="aspectFit" />
    <view class="empty-title">您的购物车暂无商品</view>
    <view class="empty-tip">再忙，也要记得买点什么犒劳下自己哦~</view>
    <view class="empty-btn" bindtap="goShopping">随便逛逛</view>
  </view>

  <!-- 商品列表 -->
  <view class="cart-list" wx:if="{{list.length > 0}}">
    <view wx:for="{{list}}" wx:key="id" class="cart-item">
      <view class="cart-check" data-id="{{item.id}}" catchtap="selectItem">
        <view class="check-circle {{item.selected ? 'checked' : ''}}">
          <text wx:if="{{item.selected}}">✓</text>
        </view>
      </view>

      <image class="cart-cover" src="{{item.cover}}" mode="aspectFill" />

      <view class="cart-info">
        <view class="cart-name">{{item.title}}</view>
        <view class="cart-spec" wx:if="{{item.spec_desc}}">
          <text class="spec-tag">{{item.spec_desc}}</text>
          <text class="spec-arrow">▼</text>
        </view>
        <view class="cart-row">
          <view class="cart-price">¥{{item.price}}</view>
          <view class="cart-qty">
            <text class="qty-btn" data-id="{{item.id}}" data-delta="-1" bindtap="changeQty">-</text>
            <text class="qty-num">{{item.quantity}}</text>
            <text class="qty-btn" data-id="{{item.id}}" data-delta="1" bindtap="changeQty">+</text>
          </view>
        </view>
      </view>

      <image class="cart-del" src="/images/trash.svg" mode="aspectFit" data-id="{{item.id}}" catchtap="removeTap" />
    </view>
  </view>

  <!-- 底部结算栏 -->
  <view class="cart-bar" wx:if="{{list.length > 0}}">
    <view class="cart-check" bindtap="selectAll">
      <view class="check-circle {{allSelected ? 'checked' : ''}}">
        <text wx:if="{{allSelected}}">✓</text>
      </view>
      <text class="check-label">全选</text>
    </view>

    <view class="cart-summary" wx:if="{{!isEdit}}">
      <text class="cart-count">共{{selectedCount}}件</text>
      <text class="cart-total">合计：<text class="total-price">¥{{total}}</text></text>
    </view>
    <view class="flex-grow" wx:if="{{isEdit}}"></view>

    <view class="cart-submit" bindtap="onSubmit">{{isEdit ? '删除' : '结算'}}</view>
  </view>

  <float-buttons />
</view>
