<view class="cart" style="--primary:{{themeColor}}">
  <view wx:if="{{list.length === 0}}" class="empty">购物车空空如也~</view>

  <view wx:for="{{list}}" wx:key="id" class="cart-item">
    <image class="cart-cover" src="{{item.cover}}" mode="aspectFill" />
    <view class="cart-mid">
      <view class="cart-title">{{item.title}}</view>
      <view class="cart-spec muted" wx:if="{{item.spec_desc}}">{{item.spec_desc}}</view>
      <view class="cart-price price">¥{{item.price}}</view>
    </view>
    <view class="cart-right">
      <view class="cart-qty">
        <text class="cart-qty-btn" data-id="{{item.id}}" data-delta="-1" bindtap="changeQty">-</text>
        <text class="cart-qty-num">{{item.quantity}}</text>
        <text class="cart-qty-btn" data-id="{{item.id}}" data-delta="1" bindtap="changeQty">+</text>
      </view>
      <text class="cart-del" data-id="{{item.id}}" bindtap="removeTap">删除</text>
    </view>
  </view>

  <view style="height:120rpx"></view>

  <view class="cart-bar" wx:if="{{list.length > 0}}">
    <view class="cart-total">合计：<text class="price">¥{{total}}</text></view>
    <view class="cart-submit" bindtap="checkout">去结算</view>
  </view>
</view>
