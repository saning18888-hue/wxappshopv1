.cart { background: #f5f5f5; min-height: 100vh; padding: 16rpx; padding-bottom: 140rpx; box-sizing: border-box; }
.cart-item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.cart-cover { width: 160rpx; height: 160rpx; border-radius: 12rpx; background: #f5f5f5; }
.cart-mid { flex: 1; padding: 0 20rpx; display: flex; flex-direction: column; }
.cart-title { font-size: 28rpx; color: #333; }
.cart-spec { font-size: 22rpx; margin: 8rpx 0; }
.cart-price { font-size: 32rpx; margin-top: auto; }
.cart-right { display: flex; flex-direction: column; justify-content: space-between; align-items: flex-end; }
.cart-qty { display: flex; align-items: center; }
.cart-qty-btn { width: 52rpx; height: 52rpx; line-height: 48rpx; text-align: center; background: #f5f5f5; border-radius: 8rpx; font-size: 30rpx; }
.cart-qty-num { width: 64rpx; text-align: center; font-size: 28rpx; }
.cart-del { font-size: 24rpx; color: #999; }

.cart-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #eee;
}
.cart-total { flex: 1; font-size: 28rpx; }
.cart-submit {
  background: var(--primary);
  color: #fff;
  border-radius: 999rpx;
  padding: 0 56rpx;
  line-height: 80rpx;
  font-size: 30rpx;
}
