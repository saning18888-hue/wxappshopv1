<view class="member" style="--primary:{{themeColor}}">
  <!-- 用户信息区 -->
  <view class="member-header">
    <view class="header-top">
      <image wx:if="{{user && user.avatarUrl}}" class="member-avatar" src="{{user.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="member-avatar avatar-text">{{avatarChar}}</view>
      <view class="member-meta">
        <view class="member-name">{{user && user.nickname ? user.nickname : '游客'}}</view>
        <view class="member-level">
          <text class="level-icon">V</text>
          <text>{{groupName || '会员等级'}}</text>
          <text wx:if="{{groupDiscountText}}" class="level-tag">{{groupDiscountText}}</text>
        </view>
      </view>
      <view class="header-right">
        <view class="sign-btn" bindtap="onSign">签到</view>
        <text class="arrow">›</text>
      </view>
    </view>

    <view class="member-stats">
      <view class="stat-item">
        <text class="stat-num">{{stats.points}}</text>
        <text class="stat-label">积分</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{stats.coupon}}</text>
        <text class="stat-label">优惠券</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{stats.balance}}</text>
        <text class="stat-label">余额</text>
      </view>
    </view>
  </view>

  <!-- 会员卡 -->
  <view class="vip-card">
    <view class="vip-left">
      <text class="vip-title">会员卡</text>
      <text class="vip-desc">享全场包邮、全场9折</text>
    </view>
    <view class="vip-btn" bindtap="onOpenVip">立即开卡</view>
  </view>

  <!-- 我的订单 -->
  <view class="order-card">
    <view class="order-title-row">
      <text class="order-title">{{orderModule.moduleName || '我的订单'}}</text>
      <view class="order-all" bindtap="goOrders">
        <text>{{orderModule.rightName || '全部订单'}}</text>
        <text class="arrow">›</text>
      </view>
    </view>
    <view class="order-status-row">
      <view class="status-item" wx:for="{{statusList}}" wx:key="key" bindtap="onStatusTap" data-status="{{item.status}}" data-link="{{item.link}}">
        <view class="status-icon-wrap">
          <image class="status-icon" src="{{item.icon}}" mode="aspectFit" />
          <view wx:if="{{item.count > 0}}" class="status-badge">{{item.count > 99 ? '99+' : item.count}}</view>
        </view>
        <text class="status-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 常用菜单 -->
  <view class="member-menu">
    <view class="menu-item" bindtap="goAddress">
      <text class="menu-label">收货地址</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goCoupon">
      <text class="menu-label">优惠券</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goService">
      <text class="menu-label">客服中心</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goAbout">
      <text class="menu-label">关于我们</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 小程序版权 -->
  <view class="copyright-box" wx:if="{{copyright.type === 'image' || copyright.type === 'text'}}">
    <image wx:if="{{copyright.type === 'image' && copyright.image}}" class="copyright-img" src="{{copyright.image}}" mode="widthFix" />
    <text wx:if="{{copyright.type === 'text' && copyright.text}}" class="copyright-text">{{copyright.text}}</text>
  </view>
</view>
