.member { min-height: 100vh; background: #f5f5f5; }

/* 用户信息区 */
.member-header {
  background: var(--primary);
  display: flex;
  flex-direction: column;
  padding: 40rpx 32rpx 80rpx;
  color: #fff;
}
.header-top {
  display: flex;
  align-items: center;
  width: 100%;
}
.member-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.3);
  border: 4rpx solid rgba(255,255,255,0.5);
}
.avatar-text {
  text-align: center;
  line-height: 100rpx;
  font-size: 40rpx;
}
.member-meta { flex: 1; margin-left: 20rpx; min-width: 0; }
.member-name { font-size: 32rpx; font-weight: 600; margin-bottom: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 320rpx; }
.member-level {
  display: inline-flex;
  align-items: center;
  background: rgba(0,0,0,0.2);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
}
.level-icon { font-size: 20rpx; font-weight: 700; margin-right: 6rpx; color: #FFE4B5; }
.header-right { display: flex; align-items: center; gap: 16rpx; }
.sign-btn {
  border: 2rpx solid #fff;
  border-radius: 999rpx;
  padding: 6rpx 24rpx;
  font-size: 24rpx;
  color: #fff;
}
.header-right .arrow { font-size: 40rpx; color: #fff; }

/* 积分/优惠券/余额 */
.member-stats {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255,255,255,0.15);
}
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}
.stat-item:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 16rpx;
  bottom: 16rpx;
  width: 1rpx;
  background: rgba(255,255,255,0.2);
}
.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}
.stat-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.75);
  margin-top: 8rpx;
}

/* 会员卡 */
.vip-card {
  margin: -30rpx 24rpx 24rpx;
  background: linear-gradient(90deg, #3a3a3a, #5c5c5c);
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,.15);
}
.vip-left { display: flex; flex-direction: column; }
.vip-title { font-size: 30rpx; font-weight: 600; margin-bottom: 8rpx; }
.vip-desc { font-size: 24rpx; color: rgba(255,255,255,0.75); }
.vip-btn {
  background: linear-gradient(90deg, #f3d69a, #e6c275);
  color: #5c3d0e;
  border-radius: 999rpx;
  padding: 10rpx 28rpx;
  font-size: 24rpx;
  font-weight: 500;
}

/* 我的订单 */
.order-card {
  background: #fff;
  border-radius: 16rpx;
  margin: 0 24rpx 20rpx;
  padding: 24rpx;
}
.order-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.order-title { font-size: 30rpx; font-weight: 600; color: #333; }
.order-all { display: flex; align-items: center; font-size: 26rpx; color: #999; }
.order-all .arrow { margin-left: 4rpx; font-size: 28rpx; }
.order-status-row { display: flex; align-items: flex-start; justify-content: space-between; }
.status-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}
.status-icon-wrap { position: relative; }
.status-icon { width: 72rpx; height: 72rpx; display: block; }
.status-label { font-size: 22rpx; color: #666; margin-top: 10rpx; }
.status-badge {
  position: absolute;
  top: -8rpx;
  right: -14rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  padding: 0 6rpx;
  background: #FF4D4F;
  color: #fff;
  border-radius: 999rpx;
  font-size: 18rpx;
  text-align: center;
  border: 2rpx solid #fff;
}

/* 常用菜单 */
.member-menu {
  background: #fff;
  border-radius: 16rpx;
  margin: 0 24rpx 24rpx;
  padding: 0 24rpx;
}
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.menu-item:last-child { border-bottom: none; }
.menu-label { font-size: 30rpx; color: #333; }
.menu-item .arrow { font-size: 30rpx; color: #ccc; }
