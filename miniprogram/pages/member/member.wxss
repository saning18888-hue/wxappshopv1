.member { padding-bottom: 40rpx; }
.member-header {
  background: linear-gradient(135deg, var(--primary), #FF8A5C);
  padding: 60rpx 40rpx;
  display: flex;
  align-items: center;
  color: #fff;
}
.member-avatar {
  width: 110rpx; height: 110rpx; border-radius: 50%;
  background: rgba(255,255,255,0.25);
  text-align: center; line-height: 110rpx; font-size: 44rpx;
}
.member-name { font-size: 36rpx; font-weight: 600; margin-left: 28rpx; }

.member-card { background: #fff; border-radius: 16rpx; margin: 16rpx; padding: 24rpx; }
.member-card-title { font-size: 30rpx; font-weight: 600; margin-bottom: 12rpx; }
.member-order { padding: 16rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.member-order-no { font-size: 26rpx; color: #666; }
.member-order-info { display: flex; justify-content: space-between; margin-top: 8rpx; font-size: 28rpx; }
.member-more { text-align: center; color: var(--primary); font-size: 26rpx; margin-top: 16rpx; }

.member-menu { background: #fff; border-radius: 16rpx; margin: 16rpx; padding: 0 24rpx; }
.member-menu-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 32rpx 0; border-bottom: 1rpx solid #f5f5f5; font-size: 30rpx; color: #333;
}
.member-menu-item:last-child { border-bottom: none; }
