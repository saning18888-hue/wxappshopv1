<view class="page" style="--primary:{{themeColor}}">
  <view class="card goods">
    <image class="g-img" src="{{goodsImage}}" mode="aspectFill" wx:if="{{goodsImage}}" />
    <view class="g-info">
      <view class="g-title">{{goodsTitle}}</view>
      <view class="g-tip">评价后将展示在商品详情页，供其他买家参考</view>
    </view>
  </view>

  <view class="card">
    <view class="block-title">商品评分</view>
    <view class="stars">
      <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" class="star {{item<=rating?'on':''}}" data-v="{{item}}" bindtap="setRating">★</text>
      <text class="star-text">{{rating}} 分</text>
    </view>
  </view>

  <view class="card">
    <view class="block-title">评价内容</view>
    <textarea class="content" placeholder="说说这件商品的使用感受吧~" value="{{content}}" bindinput="onInput" maxlength="500" />
  </view>

  <view class="spacer"></view>
  <view class="foot-bar">
    <text class="btn primary" bindtap="submit">{{submitting ? '提交中...' : '提交评价'}}</text>
  </view>
</view>
