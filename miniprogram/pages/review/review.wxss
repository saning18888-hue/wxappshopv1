.page { min-height: 100vh; background: #f5f5f5; padding-bottom: 140rpx; }
.card { background: #fff; border-radius: 16rpx; margin: 20rpx; padding: 24rpx; }
.goods { display: flex; align-items: center; }
.g-img { width: 120rpx; height: 120rpx; border-radius: 12rpx; background: #f3f3f3; flex-shrink: 0; }
.g-info { margin-left: 16rpx; flex: 1; }
.g-title { font-size: 28rpx; color: #333; }
.g-tip { font-size: 22rpx; color: #999; margin-top: 6rpx; }
.block-title { font-size: 28rpx; color: #333; font-weight: 600; margin-bottom: 16rpx; }
.stars { display: flex; align-items: center; }
.star { font-size: 48rpx; color: #ddd; margin-right: 12rpx; }
.star.on { color: #FFB400; }
.star-text { font-size: 24rpx; color: #999; margin-left: 8rpx; }
.content { width: 100%; height: 220rpx; font-size: 28rpx; color: #333; box-sizing: border-box; }
.spacer { height: 20rpx; }
.foot-bar { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; padding: 16rpx 24rpx; display: flex; justify-content: flex-end; box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.05); }
.btn { font-size: 28rpx; padding: 18rpx 60rpx; border-radius: 36rpx; }
.btn.primary { background: #FF6B35; color: #fff; }
