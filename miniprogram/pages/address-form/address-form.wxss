/* ===== 收货地址编辑表单页 — 精确复刻参考设计 ===== */
page { background: #F5F5F5; min-height: 100vh; }

/* ---- 表单行 ---- */
.form-row {
  display: flex; align-items: center; background: #fff;
  padding: 28rpx 28rpx; border-bottom: 1rpx solid var(--border);
}
.form-row-area { align-items: flex-start; }
.form-label {
  font-size: 28rpx; color: #333; width: 180rpx; flex-shrink: 0; font-weight: 500;
}
.req { color: #E54D42; margin-right: 4rpx; }
.form-input {
  flex: 1; font-size: 28rpx; color: #333; text-align: left;
}

/* 右侧区域（picker） */
.form-right { display: flex; align-items: center; flex: 1; }
.region-text { font-size: 28rpx; color: #333; flex: 1; }
.region-text.ph { color: #999; }
.arr { color: #ccc; font-size: 30rpx; margin-left: 8rpx; }

/* 定位图标 + 文字 */
.icon-loc {
  width: 28rpx; height: 28rpx; margin-left: 16rpx; position: relative; flex-shrink: 0;
}
.icon-loc::before {
  content: ''; position: absolute;
  width: 18rpx; height: 18rpx; border: 2rpx solid #999;
  border-radius: 50% 50% 50% 0; transform: rotate(-45deg); top: 2rpx; left: 3rpx;
}
.icon-loc::after {
  content: ''; position: absolute;
  width: 8rpx; height: 8rpx; background: #999;
  border-radius: 50%; top: 8rpx; left: 8rpx;
}
.loc-txt { font-size: 24rpx; color: #999; margin-left: 6rpx; }

/* 详细地址多行 */
.form-area {
  flex: 1; min-height: 120rpx; font-size: 28rpx; color: #333;
  padding: 10rpx 0; line-height: 1.5;
}

/* ---- 底部操作栏（默认地址 + 保存/取消）---- */
.action-bar {
  display: flex; align-items: center; justify-content: space-between;
  background: #fff; padding: 24rpx 28rpx; margin-top: 20rpx;
}
.default-toggle { display: flex; align-items: center; gap: 10rpx; }
.default-txt { font-size: 26rpx; color: #666; }
.act-btns { display: flex; gap: 32rpx; }
.act-btn { display: flex; align-items: center; gap: 6rpx; }
.act-btn text { font-size: 26rpx; color: #666; }

/* 保存图标 */
.icon-save {
  width: 28rpx; height: 28rpx; position: relative;
}
.icon-save::before {
  content: ''; position: absolute;
  width: 14rpx; height: 22rpx; border: 3rpx solid #666;
  border-top: none; border-left: none;
  transform: rotate(-45deg); top: 0; left: 4rpx;
}

/* 取消图标 */
.icon-cancel {
  width: 24rpx; height: 24rpx; position: relative;
}
.icon-cancel::before, .icon-cancel::after {
  content: ''; position: absolute; top: 50%; left: 50%;
  width: 20rpx; height: 3rpx; background: #999;
  border-radius: 2rpx;
}
.icon-cancel::before { transform: translate(-50%,-50%) rotate(45deg); }
.icon-cancel::after { transform: translate(-50%,-50%) rotate(-45deg); }

.save-act .icon-save::before { border-color: #E54D42; }
.cancel-act .icon-cancel::before,
.cancel-act .icon-cancel::after { background: #999; }

/* ---- 底部保存按钮栏 ---- */
.bottom-spacer { height: 160rpx; }
.save-bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 100;
  background: #fff; padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.04);
}
.save-btn {
  width: 100%; line-height: 76rpx; border-radius: 38rpx;
  background: linear-gradient(135deg, #FF6B35, #E54D42);
  color: #fff; font-size: 28rpx; font-weight: 600;
}
