.page { min-height: 100vh; background: #f5f5f5; padding-bottom: 24rpx; }
.empty { text-align: center; color: #999; font-size: 28rpx; padding: 120rpx 0; }
.list { padding: 20rpx; }
.rf { background: #fff; border-radius: 16rpx; margin-bottom: 20rpx; padding: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.rf-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.rf-type { font-size: 28rpx; color: #333; font-weight: 600; }
.rf-status { font-size: 26rpx; color: var(--primary); }
.g-row { display: flex; padding: 12rpx 0; border-top: 1rpx solid #f3f3f3; }
.g-img { width: 100rpx; height: 100rpx; border-radius: 12rpx; background: #f3f3f3; flex-shrink: 0; }
.g-info { flex: 1; margin-left: 16rpx; }
.g-title { font-size: 26rpx; color: #333; }
.g-spec { font-size: 22rpx; color: #999; }
.rf-foot { display: flex; justify-content: space-between; align-items: center; margin-top: 12rpx; padding-top: 12rpx; border-top: 1rpx solid #f3f3f3; }
.rf-reason { font-size: 24rpx; color: #666; }
.rf-amt { font-size: 28rpx; color: #E54D42; font-weight: 700; }
.rf-time { font-size: 22rpx; color: #999; margin-top: 8rpx; }
