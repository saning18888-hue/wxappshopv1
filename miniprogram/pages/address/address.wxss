/* ===== 收货地址列表页 — 精确复刻参考设计 ===== */
page { background: #F5F5F5; min-height: 100vh; }

/* ---- 列表容器 ---- */
.list { padding: 16rpx 24rpx; }

/* ---- 地址卡片 ---- */
.addr-card {
  background: #fff; border-radius: 12rpx; padding: 28rpx 24rpx; margin-bottom: 20rpx;
  border: 2rpx solid transparent;
}
.addr-default {
  border-color: var(--red); position: relative;
}

/* 姓名 + 手机 */
.a-top { display: flex; align-items: center; gap: 20rpx; }
.a-name { font-size: 32rpx; font-weight: 600; color: #1A1A1A; }
.a-phone { font-size: 30rpx; color: #333; }

/* 详细地址 */
.a-detail {
  display: block; font-size: 26rpx; color: #999; margin-top: 14rpx;
  line-height: 1.5; display: -webkit-box; -webkit-box-orient: vertical;
  -webkit-line-clamp: 2; overflow: hidden; word-break: break-all;
}

/* 底部操作行 */
.a-bar {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 22rpx; padding-top: 18rpx; border-top: 1rpx solid #f5f5f5;
}
.default-lbl { display: flex; align-items: center; gap: 8rpx; }
.default-lbl text { font-size: 26rpx; color: #666; }

/* 编辑 / 删除 */
.a-actions { display: flex; gap: 32rpx; }
.a-act { display: flex; align-items: center; gap: 6rpx; }
.a-act text { font-size: 26rpx; color: #666; }
.a-del text { color: #999; }

/* 编辑图标 */
.icon-edit {
  width: 26rpx; height: 26rpx; position: relative; flex-shrink: 0;
}
.icon-edit::before {
  content: ''; position: absolute;
  width: 14rpx; height: 22rpx; border: 3rpx solid #666;
  border-top: none; border-left: none;
  transform: rotate(-45deg); top: 0; left: 4rpx;
}

/* 删除图标（叉号） */
.icon-del {
  width: 22rpx; height: 22rpx; position: relative; flex-shrink: 0;
}
.icon-del::before, .icon-del::after {
  content: ''; position: absolute; top: 50%; left: 50%;
  width: 18rpx; height: 3rpx; background: #999; border-radius: 2rpx;
}
.icon-del::before { transform: translate(-50%,-50%) rotate(45deg); }
.icon-del::after { transform: translate(-50%,-50%) rotate(-45deg); }

/* ---- 底部按钮区（并排）---- */
.bottom-area {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 100;
  background: #fff; padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.04);
  display: flex; align-items: center; gap: 20rpx;
}

/* 微信收货地址（空心描边） */
.btn-wechat {
  flex: 1; line-height: 76rpx; border-radius: 38rpx;
  background: #fff; color: var(--red);
  border: 2rpx solid var(--red); font-size: 28rpx;
}
.btn-hover { background: #FFF5F5 !important; }

/* 新建收货地址（实心） */
.btn-new {
  flex: 1; line-height: 76rpx; border-radius: 38rpx;
  background: linear-gradient(135deg, #FF6B35, #E54D42);
  color: #fff; font-size: 28rpx; font-weight: 600;
}
.btn-hover-new { opacity: 0.9; }

/* 占位 */
.spacer { height: 130rpx; }

/* 空状态 */
.empty { text-align: center; color: #999; font-size: 28rpx; padding: 120rpx 0; }
