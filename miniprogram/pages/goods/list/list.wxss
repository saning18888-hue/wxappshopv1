.list { padding-bottom: 24rpx; }
.sort-bar {
  display: flex;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 5;
  border-bottom: 1rpx solid #eee;
}
.sort-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #555;
}
.sort-item.active { color: #FF6B35; font-weight: 600; }

.goods-grid { display: flex; flex-wrap: wrap; padding: 12rpx; }
.goods-cell {
  width: 50%;
  padding: 12rpx;
}
.goods-cell > view, .goods-cell > image { width: 100%; }
.goods-cover {
  height: 340rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
}
.goods-name {
  font-size: 28rpx;
  color: #333;
  margin-top: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.goods-sub { font-size: 22rpx; margin-top: 4rpx; }
.goods-price { font-size: 32rpx; margin-top: 8rpx; }
.goods-market { font-size: 22rpx; text-decoration: line-through; margin-left: 10rpx; }
.goods-sales { font-size: 22rpx; margin-top: 4rpx; }
