<view class="detail" wx:if="{{goods}}" style="--primary:{{themeColor}}">
  <swiper class="detail-swiper" indicator-dots autoplay circular interval="4000" indicator-active-color="var(--primary)">
    <swiper-item wx:for="{{goods.images}}" wx:key="*this">
      <image class="detail-img" src="{{item}}" mode="aspectFill" />
    </swiper-item>
  </swiper>

  <view class="detail-info">
    <view class="detail-price">
      <text class="price">¥{{currentSku ? currentSku.price : goods.price}}</text>
      <text wx:if="{{showGoodsOriginalPrice}}" class="detail-market muted">¥{{goods.market_price}}</text>
    </view>
    <view class="detail-title">{{goods.title}}</view>
    <view class="detail-sub muted">{{goods.subtitle}}</view>
    <view class="detail-meta">
      <text wx:if="{{showGoodsSales}}" class="muted">已售 {{goods.sales}} 件</text>
      <text wx:if="{{showGoodsStock && currentSku}}" class="muted">库存 {{currentSku.stock}}</text>
    </view>
    <view wx:if="{{showGoodsPromotion && goods.promotion}}" class="detail-promo">
      <text class="promo-tag">促销</text>
      <text class="promo-text">{{goods.promotion}}</text>
    </view>
  </view>

  <!-- 规格选择 -->
  <view class="spec-block" wx:if="{{goods.spec_groups.length > 0}}">
    <view class="spec-group" wx:for="{{goods.spec_groups}}" wx:key="id" wx:for-item="group">
      <view class="spec-name">{{group.name}}</view>
      <view class="spec-values">
        <text wx:for="{{group.values}}" wx:for-item="v" wx:key="id"
          class="spec-value {{selected[group.id] === v.id ? 'selected' : ''}}"
          data-spec-id="{{group.id}}" data-value-id="{{v.id}}" bindtap="selectSpec">
          {{v.value}}
        </text>
      </view>
    </view>
  </view>

  <view wx:if="{{showGoodsDetail}}" class="detail-html">
    <view class="spec-name">{{goodsDetailText}}</view>
    <rich-text nodes="{{goods.detail_html}}"></rich-text>
  </view>

  <!-- 商品属性 -->
  <view class="attr-block" wx:if="{{showGoodsAttr && goods.attrs.length > 0}}">
    <view class="spec-name">{{goodsAttrText}}</view>
    <view class="attr-row" wx:for="{{goods.attrs}}" wx:key="id" wx:for-item="attr">
      <text class="attr-name">{{attr.name}}</text>
      <text class="attr-value">{{attr.values}}</text>
    </view>
  </view>

  <!-- 商品评价 -->
  <view wx:if="{{showGoodsComment}}" class="comment-block">
    <view class="spec-name">{{goodsCommentText}}（{{goods.reviews.length}}）</view>
    <block wx:if="{{goods.reviews.length > 0}}">
      <view class="comment-item" wx:for="{{goods.reviews}}" wx:key="id" wx:for-item="rv">
        <view class="comment-head">
          <image wx:if="{{rv.avatar}}" class="comment-avatar" src="{{rv.avatar}}" mode="aspectFill" />
          <view class="comment-user">
            <text class="comment-name">{{rv.user_name}}</text>
            <view class="comment-stars">
              <text wx:for="{{[1,2,3,4,5]}}" wx:for-item="s" wx:key="*this" class="{{s <= rv.rating ? 'star on' : 'star'}}">★</text>
            </view>
          </view>
          <text class="comment-date muted">{{rv.created_at}}</text>
        </view>
        <view class="comment-content">{{rv.content}}</view>
        <view wx:if="{{rv.images.length > 0}}" class="comment-imgs">
          <image wx:for="{{rv.images}}" wx:for-item="img" wx:key="*this" class="comment-img" src="{{img}}" mode="aspectFill" />
        </view>
        <view wx:if="{{rv.reply}}" class="comment-reply">商家回复：{{rv.reply}}</view>
      </view>
    </block>
    <view wx:else class="comment-empty muted">暂无评价</view>
  </view>

  <view style="height:120rpx"></view>

  <!-- 底部操作栏 -->
  <view class="detail-bar">
    <view class="qty">
      <text class="qty-btn" bindtap="decQty">-</text>
      <text class="qty-num">{{quantity}}</text>
      <text class="qty-btn" bindtap="incQty">+</text>
    </view>
    <view class="bar-btns">
      <view wx:if="{{cartButton}}" class="bar-add" bindtap="addCart">加入购物车</view>
      <view wx:if="{{buyButton}}" class="bar-buy" bindtap="buyNow">立即购买</view>
      <view wx:if="{{!cartButton && !buyButton}}" class="bar-buy disabled">暂不可购</view>
    </view>
  </view>
</view>

<view wx:else class="empty">加载中...</view>

<float-buttons />
