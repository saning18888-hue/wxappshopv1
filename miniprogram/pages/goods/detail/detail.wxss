.detail { background: #f5f5f5; min-height: 100vh; }
.detail-swiper, .detail-img { width: 100%; height: 750rpx; }
.detail-info { background: #fff; padding: 24rpx; }
.detail-price { font-size: 44rpx; }
.detail-market { font-size: 24rpx; text-decoration: line-through; margin-left: 14rpx; }
.detail-title { font-size: 32rpx; font-weight: 600; margin-top: 12rpx; }
.detail-sub { font-size: 26rpx; margin-top: 8rpx; }
.detail-sales { font-size: 24rpx; margin-top: 8rpx; }
.detail-meta { display: flex; gap: 24rpx; margin-top: 10rpx; }
.detail-actions { display: flex; gap: 20rpx; margin-top: 20rpx; }
.detail-act {
  flex: 1; text-align: center; line-height: 64rpx; font-size: 26rpx;
  background: #f5f5f5; border-radius: 999rpx; color: #555;
}
.comment-block { background: #fff; margin-top: 16rpx; padding: 24rpx; }
.comment-empty { font-size: 24rpx; padding: 16rpx 0; }
.bar-buy.disabled { background: #bbb; }

.spec-block, .detail-html { background: #fff; margin-top: 16rpx; padding: 24rpx; }
.spec-name { font-size: 28rpx; color: #333; margin-bottom: 16rpx; }
.spec-values { display: flex; flex-wrap: wrap; }
.spec-value {
  padding: 14rpx 28rpx;
  margin: 0 20rpx 20rpx 0;
  background: #f5f5f5;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #555;
  border: 2rpx solid transparent;
}
.spec-value.selected { color: var(--primary); background: #fff2ec; border-color: var(--primary); }

.detail-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-top: 1rpx solid #eee;
}
.qty { display: flex; align-items: center; margin-right: 24rpx; }
.qty-btn { width: 56rpx; height: 56rpx; line-height: 52rpx; text-align: center; background: #f5f5f5; border-radius: 8rpx; font-size: 32rpx; }
.qty-num { width: 72rpx; text-align: center; font-size: 28rpx; }
.bar-btns { flex: 1; display: flex; }
.bar-add, .bar-buy {
  flex: 1;
  text-align: center;
  line-height: 80rpx;
  font-size: 30rpx;
  color: #fff;
  border-radius: 999rpx;
}
.bar-add { background: #FFB035; border-radius: 999rpx 0 0 999rpx; }
.bar-buy { background: var(--primary); border-radius: 0 999rpx 999rpx 0; }

/* 商品促销语 */
.detail-promo { display: flex; align-items: center; gap: 12rpx; margin-top: 14rpx; padding: 14rpx 16rpx; background: #fff7f3; border-radius: 10rpx; }
.promo-tag { flex: none; font-size: 22rpx; color: #fff; background: var(--primary); padding: 4rpx 12rpx; border-radius: 6rpx; }
.promo-text { font-size: 26rpx; color: #ff4d4f; font-weight: 500; }

/* 商品属性 */
.attr-block { background: #fff; margin-top: 16rpx; padding: 24rpx; }
.attr-row { display: flex; padding: 14rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.attr-row:last-child { border-bottom: none; }
.attr-name { width: 160rpx; flex: none; font-size: 26rpx; color: #999; }
.attr-value { flex: 1; font-size: 26rpx; color: #333; }

/* 商品评价 */
.comment-item { padding: 20rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.comment-item:last-child { border-bottom: none; }
.comment-head { display: flex; align-items: center; }
.comment-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; background: #eee; }
.comment-user { flex: 1; margin-left: 16rpx; display: flex; flex-direction: column; }
.comment-name { font-size: 26rpx; color: #333; }
.comment-stars { margin-top: 4rpx; }
.star { color: #ddd; font-size: 24rpx; }
.star.on { color: #ffb400; }
.comment-date { font-size: 22rpx; }
.comment-content { font-size: 26rpx; color: #333; margin-top: 12rpx; line-height: 1.6; }
.comment-imgs { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.comment-img { width: 150rpx; height: 150rpx; border-radius: 8rpx; background: #f5f5f5; }
.comment-reply { margin-top: 12rpx; padding: 14rpx 16rpx; background: #f8f8f8; border-radius: 8rpx; font-size: 24rpx; color: #666; }
