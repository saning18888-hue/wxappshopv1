APP_DEBUG = true

# 数据库驱动：mysql（服务器）或 sqlite（本地免装 MySQL）
DB_DRIVER = mysql
# 本地 SQLite 模式下的数据库文件路径（DB_DRIVER=sqlite 时生效）
DB_SQLITE_PATH = database/wxappb2c.sqlite

# 数据库（MySQL 5.7+，DB_DRIVER=mysql 时生效）
DB_HOST = 127.0.0.1
DB_NAME = wxappb2c
DB_USER = root
DB_PASS =
DB_PORT = 3306
DB_PREFIX =

# 微信相关（联调真实登录/支付时填写，切勿提交真实密钥）
WECHAT_APPID =
WECHAT_APPSECRET =
WECHAT_MCH_ID =
WECHAT_MCH_KEY =
WECHAT_NOTIFY_URL =

# 是否开启开发态 Mock 登录（true 时 /api/v1/auth/dev_login 可直接换 token）
DEV_MOCK_LOGIN = true

# 运营后台登录口令（本地管理后台用，生产请务必修改）
ADMIN_USER = admin
ADMIN_PASS = admin123
ADMIN_SECRET = change_this_admin_secret_please
